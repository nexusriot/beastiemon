#!/bin/sh
#
# PROVIDE: beastied
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# Add to /etc/rc.conf to enable:
#   beastied_enable="YES"
#
# Optional overrides in /etc/rc.conf:
#   beastied_config="/usr/local/etc/beastiemon.conf"
#   beastied_runas="_beastie"     # unprivileged user daemon drops to
#   beastied_flags=""
#
# NOTE: The variable is named "beastied_runas" on purpose.
# rc.subr treats ${name}_user as a magic variable and runs the *entire*
# command line (including daemon(8) itself) as that user, which prevents
# daemon from writing its PID file to /var/run/.  By using a different name
# we keep daemon(8) starting as root so it can write the PID file, then
# it drops to _beastie via its own -u flag before exec'ing beastied.

. /etc/rc.subr

name="beastied"
rcvar="beastied_enable"
load_rc_config "$name"

: ${beastied_enable:="NO"}
: ${beastied_runas:="_beastie"}
: ${beastied_config:="/usr/local/etc/beastiemon.conf"}
: ${beastied_logfile:="/var/log/beastied.log"}
: ${beastied_flags:=""}

pidfile="/var/run/beastied.pid"
# daemon(8) also writes the *child* (beastied) PID here via -p, so
# `service beastied reload` can SIGHUP beastied itself (config reload)
# rather than the supervisor.
childpidfile="/var/run/beastied_child.pid"

# procname must match the process that OWNS the pidfile.
# daemon(8) -P writes its own (supervisor) PID, so procname is daemon, not beastied.
# rc.subr uses procname + pidfile for check_pidfile / pgrep, stop, and status.
procname="/usr/sbin/daemon"
command="/usr/sbin/daemon"
command_args="-f -r -P ${pidfile} -p ${childpidfile} -u ${beastied_runas} \
    -o ${beastied_logfile} %%PREFIX%%/bin/beastied \
    -config ${beastied_config} ${beastied_flags}"

# `service beastied reload` hot-reloads the config (auth, alerts, sampler
# options) without a restart by sending SIGHUP straight to beastied.
extra_commands="reload"
reload_cmd="beastied_reload"
beastied_reload() {
    if [ -f "${childpidfile}" ]; then
        kill -HUP "$(cat "${childpidfile}")" && echo "beastied: configuration reloaded"
    else
        echo "beastied: ${childpidfile} not found; is it running?"
        return 1
    fi
}

start_precmd="beastied_prestart"
beastied_prestart() {
    # Create/fix log file ownership before daemon drops privileges.
    touch "${beastied_logfile}"
    chown root:"${beastied_runas}" "${beastied_logfile}"
    chmod 0640 "${beastied_logfile}"
}

run_rc_command "$1"
